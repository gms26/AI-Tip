# ==============================================================
# AI Tip Assistant - Environment Variables
# ==============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file containing real secrets to version control.
# ==============================================================

# --------------------------
# Core Settings
# --------------------------
# The PostgreSQL Database URL
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/aitip_db

# The secret key for signing JWTs. Must be exactly 32 bytes (64 hex characters) or more.
JWT_SECRET=your_32_byte_hex_encoded_secret_here

# --------------------------
# External APIs (Required)
# --------------------------
# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------
# External Integrations (Toggleable)
# --------------------------

# Payment Provider Integration
# Options: mock, stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_...

# POS Provider Integration
# Options: mock, square
POS_PROVIDER=mock
SQUARE_ACCESS_TOKEN=EAAA...

# Restaurant Provider Integration
# Options: mock, google
RESTAURANT_PROVIDER=mock
GOOGLE_PLACES_API_KEY=AIza...
